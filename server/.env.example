# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mock-interview

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Gemini API Key (for interview AI questions, follow-ups, and feedback)
GEMINI_API_KEY=your_gemini_api_key_here

# Murf AI API Key (for realistic text-to-speech audio)
MURF_API_KEY=your_murf_api_key_here

# AssemblyAI API Key (for voice answer transcription)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
